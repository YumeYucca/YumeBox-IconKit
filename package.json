{
  "name": "yumebox-iconkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "r2:lifecycle": "wrangler r2 bucket lifecycle add yumebox-iconkit-jobs expire-iconkit-jobs jobs/ --expire-days 1 --force",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "wrangler": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest"
  },
  "packageManager": "npm@11.13.0"
}
